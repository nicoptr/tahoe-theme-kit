diff -ruN compiz-windows-effect@hermes83.github.com/src/effects/shadow_mirror.js compiz-windows-effect@hermes83.github.com/src/effects/shadow_mirror.js
--- compiz-windows-effect@hermes83.github.com/src/effects/shadow_mirror.js	1970-01-01 01:00:00.000000000 +0100
+++ compiz-windows-effect@hermes83.github.com/src/effects/shadow_mirror.js	2026-11-03 10:33:13.197828453 +0100
@@ -0,0 +1,68 @@
+'use strict';
+
+import Clutter from 'gi://Clutter';
+import GObject from 'gi://GObject';
+
+// Deforms the shadow actor of "Rounded Window Corners Reborn" with the same
+// wobbly model as its window, so the shadow follows the window wobble.
+export class ShadowMirrorEffect extends Clutter.DeformEffect {
+    static {
+        GObject.registerClass(this);
+    }
+
+    _init(source, windowActor, tiles) {
+        super._init();
+        this.source = source;
+        this.windowActor = windowActor;
+        this.set_n_tiles(tiles[0], tiles[1]);
+    }
+
+    vfunc_modify_paint_volume(pv) {
+        return false;
+    }
+
+    vfunc_deform_vertex(w, h, v) {
+        const model = this.source.wobblyModel;
+        const shadow = this.get_actor();
+        if (!model || !shadow) {
+            return;
+        }
+
+        const [shadowW, shadowH] = shadow.get_size();
+        const offsetX = shadow.x - this.windowActor.x;
+        const offsetY = shadow.y - this.windowActor.y;
+        const tx = (v.tx * shadowW + offsetX) / this.source.width;
+        const ty = (v.ty * shadowH + offsetY) / this.source.height;
+
+        const [x, y] = bezier(model.objects, tx, ty);
+        v.x = (x + this.source.deltaX - offsetX) * w / shadowW;
+        v.y = (y + this.source.deltaY - offsetY) * h / shadowH;
+    }
+
+    destroy() {
+        this.get_actor()?.remove_effect(this);
+        this.source = null;
+        this.windowActor = null;
+    }
+}
+
+function bernstein(t) {
+    const s = 1 - t;
+    return [s * s * s, 3 * t * s * s, 3 * t * t * s, t * t * t];
+}
+
+function bezier(objects, tx, ty) {
+    const bx = bernstein(tx);
+    const by = bernstein(ty);
+    let x = 0;
+    let y = 0;
+    for (let j = 0; j < 4; j++) {
+        for (let i = 0; i < 4; i++) {
+            const c = by[j] * bx[i];
+            const o = objects[j * 4 + i];
+            x += c * o.x;
+            y += c * o.y;
+        }
+    }
+    return [x, y];
+}
